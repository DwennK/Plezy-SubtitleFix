+// Private, opt-in LiveSync transport. Never observe livesync-pcm: GET drains
+// the bounded queue. Clients poll it on their worker and reject old playback
+// generations. A new audio chain starts disabled and must be enabled again.
+static int mp_property_livesync_enabled(void *ctx, struct m_property *prop,
+                                       int action, void *arg)
+{
+    MPContext *mpctx = ctx;
+    if (action == M_PROPERTY_GET_TYPE) {
+        *(struct m_option *)arg = (struct m_option){.type = CONF_TYPE_FLAG};
+        return M_PROPERTY_OK;
+    }
+    struct mp_output_chain *c = mpctx->ao_chain ? mpctx->ao_chain->filter : NULL;
+    if (!c)
+        return M_PROPERTY_UNAVAILABLE;
+    if (action == M_PROPERTY_GET) {
+        *(int *)arg = c->livesync != NULL;
+        return M_PROPERTY_OK;
+    }
+    if (action == M_PROPERTY_SET) {
+        if (*(int *)arg &&
+            !af_fmt_is_pcm(mp_aframe_get_format(c->input_aformat)))
+            return M_PROPERTY_UNAVAILABLE;
+        mp_output_livesync_enable(c, *(int *)arg != 0);
+        return M_PROPERTY_OK;
+    }
+    return M_PROPERTY_NOT_IMPLEMENTED;
+}
+
+static int mp_property_livesync_pcm(void *ctx, struct m_property *prop,
+                                   int action, void *arg)
+{
+    MPContext *mpctx = ctx;
+    if (action == M_PROPERTY_GET_TYPE) {
+        *(struct m_option *)arg = (struct m_option){.type = CONF_TYPE_NODE};
+        return M_PROPERTY_OK;
+    }
+    struct mp_output_chain *c = mpctx->ao_chain ? mpctx->ao_chain->filter : NULL;
+    if (!c || !c->livesync)
+        return M_PROPERTY_UNAVAILABLE;
+    if (action != M_PROPERTY_GET)
+        return M_PROPERTY_NOT_IMPLEMENTED;
+    mp_output_livesync_read(c, arg);
+    return M_PROPERTY_OK;
+}
