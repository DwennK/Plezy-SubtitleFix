+// The decoder path only copies to already allocated memory. No allocation,
+// resampling, inference, disk/network I/O or waiting in the capture operation.
+// 64 * 64 KiB bounds the raw queue. The consumer owns the 30s analysis ring.
+#define LIVESYNC_SLOTS 64
+#define LIVESYNC_FRAME_BYTES 65536
+struct mp_livesync_packet {
+    double pts, speed;
+    int rate, channels, samples, format, planes, plane_bytes;
+    uint8_t data[LIVESYNC_FRAME_BYTES];
+};
+struct mp_livesync_tap {
+    struct mp_livesync_packet packets[LIVESYNC_SLOTS];
+    int head, count;
+    int64_t epoch, dropped;
+};
+
+static void livesync_reset(struct mp_livesync_tap *tap)
+{
+    if (!tap)
+        return;
+    tap->head = tap->count = 0;
+    tap->epoch++;
+}
+
+static void livesync_capture(struct mp_livesync_tap *tap, struct mp_aframe *a)
+{
+    if (!tap)
+        return;
+    int planes = mp_aframe_get_planes(a);
+    int samples = mp_aframe_get_size(a);
+    size_t stride = mp_aframe_get_sstride(a);
+    double pts = mp_aframe_get_pts(a);
+    if (!af_fmt_is_pcm(mp_aframe_get_format(a)) || !isfinite(pts) ||
+        pts == MP_NOPTS_VALUE || samples <= 0 || planes <= 0 ||
+        stride == 0 || stride > LIVESYNC_FRAME_BYTES / planes ||
+        samples > LIVESYNC_FRAME_BYTES / (stride * planes)) {
+        livesync_reset(tap);
+        tap->dropped++;
+        return;
+    }
+    if (tap->count == LIVESYNC_SLOTS) {
+        livesync_reset(tap);
+        tap->dropped++;
+    }
+    struct mp_livesync_packet *p =
+        &tap->packets[(tap->head + tap->count) % LIVESYNC_SLOTS];
+    p->pts = pts;
+    p->speed = mp_aframe_get_speed(a);
+    p->rate = mp_aframe_get_rate(a);
+    p->channels = mp_aframe_get_channels(a);
+    p->samples = samples;
+    p->format = mp_aframe_get_format(a);
+    p->planes = planes;
+    p->plane_bytes = samples * stride;
+    uint8_t **data = mp_aframe_get_data_ro(a);
+    for (int n = 0; n < planes; n++)
+        memcpy(p->data + n * p->plane_bytes, data[n], p->plane_bytes);
+    tap->count++;
+}
+
+void mp_output_livesync_enable(struct mp_output_chain *c, bool enabled)
+{
+    if (!enabled) {
+        if (c->livesync) {
+            // Erase dialogue samples before releasing the private allocation.
+            memset(c->livesync, 0, sizeof(*c->livesync));
+            TA_FREEP(&c->livesync);
+        }
+    } else if (!c->livesync) {
+        c->livesync = talloc_zero(c->f, struct mp_livesync_tap);
+    }
+}
+
+void mp_output_livesync_read(struct mp_output_chain *c, struct mpv_node *out)
+{
+    struct mp_livesync_tap *tap = c->livesync;
+    node_init(out, MPV_FORMAT_NODE_MAP, NULL);
+    node_map_add_int64(out, "version", 1);
+    node_map_add_int64(out, "epoch", tap ? tap->epoch : 0);
+    node_map_add_int64(out, "dropped", tap ? tap->dropped : 0);
+    struct mpv_node *frames = node_map_add(out, "frames", MPV_FORMAT_NODE_ARRAY);
+    // Bound a single bridge transfer to at most 256 KiB of sample bytes.
+    int bytes = 0;
+    while (tap && tap->count) {
+        struct mp_livesync_packet *p = &tap->packets[tap->head];
+        int size = p->planes * p->plane_bytes;
+        if (bytes + size > 262144)
+            break;
+        bytes += size;
+        struct mpv_node *n = node_array_add(frames, MPV_FORMAT_NODE_MAP);
+        node_map_add_double(n, "pts", p->pts);
+        node_map_add_double(n, "speed", p->speed);
+        node_map_add_int64(n, "rate", p->rate);
+        node_map_add_int64(n, "channels", p->channels);
+        node_map_add_int64(n, "samples", p->samples);
+        node_map_add_int64(n, "planes", p->planes);
+        node_map_add_string(n, "format", af_fmt_to_str(p->format));
+        struct mpv_node *pcm = node_map_add(n, "pcm", MPV_FORMAT_BYTE_ARRAY);
+        pcm->u.ba->size = size;
+        pcm->u.ba->data = talloc_memdup(pcm->u.ba, p->data, size);
+        memset(p->data, 0, size);
+        tap->head = (tap->head + 1) % LIVESYNC_SLOTS;
+        tap->count--;
+    }
+}
